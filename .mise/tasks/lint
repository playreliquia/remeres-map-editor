#!/usr/bin/env bash
#MISE description="Run the prek hooks over every file changed since main"
#USAGE arg "[path]..." help="Limit the run to these paths"
# Only the files that differ from LINT_BASE, committed or not. LINT_BASE defaults to the
# merge-base with origin/main.
set -euo pipefail

base=${LINT_BASE:-$(git merge-base origin/main HEAD)}
files=$(git diff --name-only --diff-filter=d "${base}" -- "$@")
files=$(grep -v '^$' <<<"${files}" || true)
if [[ -z "${files}" ]]; then
  echo "no files changed since ${base}"
  exit 0
fi
# xargs -r is GNU-only; the emptiness check above covers it.
printf '%s\n' "${files}" | tr '\n' '\0' | xargs -0 prek run --show-diff-on-failure --files
