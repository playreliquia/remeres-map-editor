root = true

# General configuration
[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,lua,xml}]
indent_style = tab
indent_size = 4

[**.{.cpp,.h}]
# Options not ubiquitous, but useful
indent_brace_style = K&R
spaces_around_brackets = none

[.travis.yml]
indent_style = space
indent_size = 2

# The fork's tooling files indent with spaces, as YAML must. The editorconfig-checker hook in
# .pre-commit-config.yaml checks them, and shfmt reads the shell keys.
[{.github/**,.vscode/**,.mise/**,.config/**,cmake/triplets/**,docs/agents/**,docs/building/README.md,.pre-commit-config.yaml,.renovaterc.json5,release-please-config.json,.release-please-manifest.json,mise.lock,tools/*.sh,tests/tools/*.sh}]
indent_style = space
indent_size = 2

[{.mise/tasks/**,.mise/lib/**,tools/*.sh,tests/tools/*.sh}]
switch_case_indent = true
